{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && STANDALONE=$(find .next/standalone -name server.js -not -path '*/node_modules/*' | head -1 | xargs dirname) && cp -r public $STANDALONE/public && cp -r .next/static $STANDALONE/.next/static && echo \"Standalone at: $STANDALONE\"",
    "start": "HOSTNAME=0.0.0.0 node $(find .next/standalone -name server.js -not -path '*/node_modules/*' | head -1)",
    "lint": "eslint"
  },
  "dependencies": {
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^2.1.1",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
